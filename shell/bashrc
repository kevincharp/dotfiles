# --- [tools] claude-smg: lanza Claude Code con el perfil Bedrock de SMG | uso: claude-smg ---
claude-smg() {
    # En un subshell: las variables exportadas no pisan las del entorno.
    (
        # El perfil sale de $AWS_SSO_PROFILE (~/.env), el mismo que escribe el bootstrap.
        export CLAUDE_CODE_USE_BEDROCK="1"
        export AWS_PROFILE="${AWS_SSO_PROFILE:-${CLAUDE_SMG_AWS_PROFILE:-default}}"
        export AWS_REGION="${CLAUDE_SMG_AWS_REGION:-us-east-1}"
        # La cuenta solo habilita esos modelos en Bedrock: el picker se restringe con
        # availableModels y el primero es el default. Se pisan con CLAUDE_SMG_MODELS.
        _smg_models="${CLAUDE_SMG_MODELS:-${CLAUDE_SMG_MODEL:-us.anthropic.claude-sonnet-5-5,us.anthropic.claude-haiku-5-5}}"
        _smg_models="${_smg_models// /}"
        export ANTHROPIC_MODEL="${_smg_models%%,*}"
        # El picker tiene entradas fijas por familia: cada una se apunta al modelo de la lista.
        _smg_pick() { printf '%s\n' "$_smg_models" | tr ',' '\n' | grep -m1 -i "$1"; }
        _smg_sonnet="$(_smg_pick sonnet)"; _smg_haiku="$(_smg_pick haiku)"; _smg_opus="$(_smg_pick opus)"
        [[ -n "$_smg_sonnet" ]] && export ANTHROPIC_DEFAULT_SONNET_MODEL="$_smg_sonnet"
        [[ -n "$_smg_opus" ]]   && export ANTHROPIC_DEFAULT_OPUS_MODEL="$_smg_opus"
        # Haiku hace ademas las tareas de fondo.
        _smg_haiku="${CLAUDE_SMG_SMALL_MODEL:-${_smg_haiku:-us.anthropic.claude-haiku-5-5}}"
        export ANTHROPIC_DEFAULT_HAIKU_MODEL="$_smg_haiku"
        export ANTHROPIC_SMALL_FAST_MODEL="$_smg_haiku"   # nombre viejo, por compat
        # security-guidance revisa con Opus, bloqueado en esta cuenta: se fija al Sonnet de la lista.
        if [[ -n "$_smg_sonnet" ]]; then
            export SECURITY_REVIEW_MODEL="$_smg_sonnet"
            export SG_AGENTIC_MODEL="$_smg_sonnet"
        fi
        # JSON del picker: "a,b" -> ["a","b"]
        _smg_json="[\"${_smg_models//,/\",\"}\"]"

        if ! aws sts get-caller-identity --profile "$AWS_PROFILE" >/dev/null 2>&1; then
            echo "Sesion SSO caducada o ausente, ejecutando: aws sso login --profile $AWS_PROFILE"
            aws sso login --profile "$AWS_PROFILE" || {
                echo "Fallo el login SSO, abortando." >&2
                exit 1
            }
            # Con el perfil incompleto el login anda pero no hay credenciales.
            if ! aws sts get-caller-identity --profile "$AWS_PROFILE" >/dev/null 2>&1; then
                echo "El login SSO funciono pero el perfil '$AWS_PROFILE' no obtiene credenciales (revisa sso_account_id / sso_role_name con: aws configure sso)." >&2
                exit 1
            fi
        fi

        exec claude --settings "{\"availableModels\":$_smg_json}" "$@"
    )
}

# ==============================================================================
# ICLOUD DRIVE — montar/desmontar via rclone (backend iclouddrive)
# ------------------------------------------------------------------------------
# rclone monta iCloud Drive como carpeta local. El remote 'icloud' se configura una vez
# con 'rclone config'. Solo Linux (FUSE). Variables: $ICLOUD_REMOTE, $ICLOUD_MOUNT.
# ==============================================================================

ICLOUD_REMOTE="${ICLOUD_REMOTE:-icloud}"
ICLOUD_MOUNT="${ICLOUD_MOUNT:-$HOME/icloud}"
export ICLOUD_REMOTE ICLOUD_MOUNT

# --- [nube] icloud-relink: reautentica el remote cuando caduco la sesion | uso: icloud-relink ---
# Apple invalida el trust_token cada tanto ("421 Misdirected Request"). Pide el codigo
# del iPhone y la password real del Apple ID (las app-specific no sirven).
icloud-relink() {
    if ! command -v rclone &>/dev/null; then
        echo "rclone no esta instalado (bootstrap: bash install.sh --tools=rclone)" >&2
        return 1
    fi
    echo "Reautenticando '${ICLOUD_REMOTE}' (tene a mano el codigo 2FA del iPhone)..."
    if ! rclone config reconnect "${ICLOUD_REMOTE}:"; then
        echo "Fallo el reconnect. Alternativa: rclone config update ${ICLOUD_REMOTE}" >&2
        return 1
    fi
    echo "Sesion de iCloud renovada."
}

# 0 = OK, 2 = sesion caducada, 1 = otro fallo.
# --- [nube] _icloud_probe: (interna) verifica que la sesion de iCloud siga viva | uso: _icloud_probe ---
_icloud_probe() {
    local out rc=0
    out="$(rclone lsd "${ICLOUD_REMOTE}:" --retries 1 --low-level-retries 1 2>&1)" || rc=$?
    [ "$rc" -eq 0 ] && return 0
    if printf '%s' "$out" | grep -qE 'Invalid global session|421 Misdirected|401 Unauthorized'; then
        return 2
    fi
    printf '%s\n' "$out" >&2
    return 1
}

# --- [nube] _icloud_check: (interna) verifica rclone, el remote y la sesion | uso: _icloud_check ---
_icloud_check() {
    if ! command -v rclone &>/dev/null; then
        echo "rclone no esta instalado (bootstrap: bash install.sh --tools=rclone)" >&2
        return 1
    fi
    if ! rclone listremotes 2>/dev/null | grep -qx "${ICLOUD_REMOTE}:"; then
        echo "Remote '${ICLOUD_REMOTE}' no configurado. Ejecuta: rclone config" >&2
        return 1
    fi
    local rc=0
    _icloud_probe || rc=$?
    case "$rc" in
        0) return 0 ;;
        2)
            echo "Sesion de iCloud caducada (Apple invalida el token cada tanto)." >&2
            if [ -t 0 ]; then
                printf "Reautenticar ahora con el codigo 2FA del iPhone? [s/N] "
                local reply; read -r reply
                case "$reply" in
                    [sSyY]) icloud-relink && _icloud_probe && return 0 ;;
                esac
            fi
            echo "Corre: icloud-relink" >&2
            return 1
            ;;
        *)
            echo "No se pudo contactar iCloud (error arriba). Revisa la red y reintenta." >&2
            return 1
            ;;
    esac
}

# --- [nube] icloud-mount: monta iCloud Drive en ~/icloud | uso: icloud-mount ---
icloud-mount() {
    _icloud_check || return 1
    if mountpoint -q "$ICLOUD_MOUNT" 2>/dev/null; then
        echo "Ya montado en $ICLOUD_MOUNT"
        return 0
    fi
    mkdir -p "$ICLOUD_MOUNT"
    rclone mount "${ICLOUD_REMOTE}:" "$ICLOUD_MOUNT" --vfs-cache-mode full --daemon \
        && echo "iCloud Drive montado en $ICLOUD_MOUNT"
}

# --- [nube] icloud-umount: desmonta iCloud Drive | uso: icloud-umount ---
icloud-umount() {
    if mountpoint -q "$ICLOUD_MOUNT" 2>/dev/null; then
        fusermount3 -u "$ICLOUD_MOUNT" 2>/dev/null || fusermount -u "$ICLOUD_MOUNT"
        echo "Desmontado $ICLOUD_MOUNT"
    else
        echo "No estaba montado: $ICLOUD_MOUNT"
    fi
}

# --- [nube] icloud-ls: lista una carpeta de iCloud sin descargar nada | uso: icloud-ls [carpeta] ---
icloud-ls() {
    _icloud_check || return 1
    rclone lsf "${ICLOUD_REMOTE}:${1:-}"
}

# --- [nube] icloud-pull: copia una carpeta de iCloud al destino (incremental) | uso: icloud-pull <carpeta-remota> <destino-local> ---
# Ej:  icloud-pull images /run/media/$USER/disco-externo/Fotos
icloud-pull() {
    local src="${1:?Uso: icloud-pull <carpeta-remota> <destino-local>}"
    local dst="${2:?Uso: icloud-pull <carpeta-remota> <destino-local>}"
    _icloud_check || return 1
    rclone copy "${ICLOUD_REMOTE}:${src}" "$dst" -P --transfers 8
}

# --- [nube] icloud-move: mueve una carpeta de iCloud al destino (libera espacio) | uso: icloud-move <carpeta-remota> <destino-local> ---
# Borra de iCloud cada archivo copiado; muestra un dry-run y pide confirmacion.
icloud-move() {
    local src="${1:?Uso: icloud-move <carpeta-remota> <destino-local>}"
    local dst="${2:?Uso: icloud-move <carpeta-remota> <destino-local>}"
    _icloud_check || return 1
    echo "== Simulacion (dry-run): esto se moveria de iCloud '${src}' a '${dst}' =="
    rclone move "${ICLOUD_REMOTE}:${src}" "$dst" --dry-run -P || return 1
    echo
    printf "Mover de verdad y BORRAR de iCloud '%s'? [s/N] " "${src}"
    local reply; read -r reply
    case "$reply" in
        [sSyY]) rclone move "${ICLOUD_REMOTE}:${src}" "$dst" -P --transfers 8 \
                    --delete-empty-src-dirs ;;
        *) echo "Cancelado. Nada se movio." ;;
    esac
}

# ==============================================================================
# DOTHELP — ayuda del repo: lista comandos por categoría
# ==============================================================================
# La info sale de un comentario anotado encima de cada definición:
#   # --- [categoria] nombre: descripción | uso: nombre <arg> [opcional] ---
# <arg> = requerido, [arg] = opcional; la línea de uso solo se muestra si el
# comando lleva argumentos. Categorías (orden de salida): git, nav, sistema, ssh,
# nube, tools, dotfiles. Los aliases se detectan solos (g* = git, el resto = nav).
# Paridad con zshrc/profile.ps1.
#   dothelp        menú interactivo (fzf): categoría → comando; deja el NOMBRE
#                  listo (zsh escrito en la línea; bash, impreso)
#   dothelp git    listado estático filtrado; sin fzf o a un pipe, cae al estático

# Fuente ÚNICA de datos: emite un registro por comando en formato TSV
#   categoría <tab> nombre <tab> descripción <tab> uso
# La usan tanto el menú interactivo como el listado estático. Dos pasadas para
# que las funciones (anotadas con # --- [cat] ... ---) salgan ANTES que los
# aliases (categoría inferida: g* → git, resto → nav; descripción = qué ejecutan).
_dothelp_emit() {
    local line cat name rest desc uso aname aval acat
    # Pasada 1: funciones anotadas (van primero en cada categoría).
    while IFS= read -r line; do
        [[ "$line" =~ ^#\ ---\ \[([a-zA-Z]+)\]\ ([a-zA-Z_][a-zA-Z0-9_-]*):\ (.*)\ ---$ ]] || continue
        cat="${BASH_REMATCH[1]}"; name="${BASH_REMATCH[2]}"; rest="${BASH_REMATCH[3]}"
        # Las internas (_nombre) no van al menu.
        [[ "$name" == _* ]] && continue
        if [[ "$rest" =~ ^(.*)\ \|\ uso:\ (.*)$ ]]; then
            desc="${BASH_REMATCH[1]}"; uso="${BASH_REMATCH[2]}"
        else
            desc="$rest"; uso=""
        fi
        printf '%s\t%s\t%s\t%s\n' "$cat" "$name" "$desc" "$uso"
    done < "$_dh_file"
    # Pasada 2: aliases (después de las funciones). Categoría inferida.
    while IFS= read -r line; do
        [[ "$line" =~ ^alias\ ([a-zA-Z_][a-zA-Z0-9_-]*)=\'(.+)\'$ ]] || \
        [[ "$line" =~ ^alias\ ([a-zA-Z_][a-zA-Z0-9_-]*)=\"(.+)\"$ ]] || continue
        aname="${BASH_REMATCH[1]}"; aval="${BASH_REMATCH[2]}"
        if [[ "$aname" == g* ]]; then acat='git'; else acat='nav'; fi
        printf '%s\t%s\t→ %s\t\n' "$acat" "$aname" "$aval"
    done < "$_dh_file"
}

# Listado estático (fallback): agrupa por categoría, con color. Se usa cuando no
# hay fzf, la salida no es terminal, o se pasó un filtro explícito (dothelp git).
_dothelp_static() {
    local filter="$1" data="$2"
    local -a cats=(git nav sistema ssh nube tools dotfiles)
    local -A titles=([git]="GIT" [nav]="NAVEGACIÓN / ARCHIVOS" [sistema]="SISTEMA / PROCESOS"
                     [ssh]="SSH / CLAVES" [nube]="NUBE (iCloud)" [tools]="HERRAMIENTAS" [dotfiles]="DOTFILES / CONFIG")
    local c cat name desc uso first
    for c in "${cats[@]}"; do
        first=1
        while IFS=$'\t' read -r cat name desc uso; do
            [[ "$cat" == "$c" ]] || continue
            if [[ -n "$filter" ]]; then
                [[ "$name" == *"$filter"* || "$desc" == *"$filter"* || "$cat" == *"$filter"* ]] || continue
            fi
            if (( first )); then
                printf '\n%s❯ %s%s\n\n' "$_dh_cat" "${titles[$c]}" "$_dh_reset"
                first=0
            fi
            printf '  %s%-18s%s %s\n' "$_dh_name" "$name" "$_dh_reset" "$desc"
            if [[ -n "$uso" && "$uso" != "$name" ]]; then
                printf '  %s  ↳ %s%s\n' "$_dh_dim" "$uso" "$_dh_reset"
            fi
        done <<< "$data"
    done
    printf '\n'
}

# Menú en dos pasos: categoría → comando. Se copia solo el nombre: la plantilla de uso
# no es ejecutable.
_dothelp_menu() {
    local data="$1"
    local -a cats=(git nav sistema ssh nube tools dotfiles)
    local -A titles=([git]="GIT" [nav]="NAVEGACIÓN / ARCHIVOS" [sistema]="SISTEMA / PROCESOS"
                     [ssh]="SSH / CLAVES" [nube]="NUBE (iCloud)" [tools]="HERRAMIENTAS" [dotfiles]="DOTFILES / CONFIG")
    # Menú del paso 1 (categorías con conteo). Se arma una sola vez.
    local c cnt menu1=""
    for c in "${cats[@]}"; do
        cnt=$(printf '%s\n' "$data" | awk -F'\t' -v k="$c" '$1==k{n++} END{print n+0}')
        (( cnt > 0 )) && menu1+="$c"$'\t'"${titles[$c]} ($cnt)"$'\n'
    done

    # Bucle de dos niveles: Esc en el paso 2 (comando) VUELVE al paso 1
    # (categorías); solo se sale del todo con Esc en el paso 1.
    local pick1 cat pick2 name uso
    while true; do
        pick1=$(printf '%s' "$menu1" | fzf --delimiter=$'\t' --with-nth=2 \
            --prompt='categoría> ' --height=50% --border=rounded --layout=reverse \
            --header='↑↓ categoría · Enter abre · Esc cancela')
        [[ -n "$pick1" ]] || return          # Esc en categorías → salir
        cat="${pick1%%$'\t'*}"

        # Paso 2: elegir comando de esa categoría, con preview.
        pick2=$(printf '%s\n' "$data" | awk -F'\t' -v k="$cat" '$1==k' | \
            fzf --delimiter=$'\t' --with-nth=2,3 \
                --prompt="$cat> " --height=70% --border=rounded --layout=reverse \
                --header='↑↓ comando · Enter lo elige · Esc vuelve a categorías' \
                --preview='printf "Comando:\n  %s\n\n%s\n\nUso:\n  %s\n" {2} {3} {4}' \
                --preview-window=right:45%:wrap)
        [[ -n "$pick2" ]] || continue        # Esc en comandos → volver al paso 1
        name=$(printf '%s' "$pick2" | cut -f2)
        uso=$(printf '%s' "$pick2" | cut -f4)
        # bash: no hay 'print -z'; se imprime el comando para copiar (paridad con matices).
        if [[ -n "$uso" && "$uso" != "$name" ]]; then
            printf '%suso:%s %s\n' "$_dh_dim" "$_dh_reset" "$uso"
        fi
        printf '%scopiá y ejecutá:%s %s%s %s\n' "$_dh_dim" "$_dh_reset" "$_dh_name" "$name" "$_dh_reset"
        return
    done
}

dothelp() {
    local _dh_filter="${1:-}"
    local _dh_file="${BASH_SOURCE[0]:-$HOME/.bashrc}"
    # Colores (paleta Claude) solo si la salida es una terminal.
    local _dh_cat='' _dh_name='' _dh_dim='' _dh_reset=''
    if [[ -t 1 ]]; then
        _dh_cat=$'\033[1;38;5;173m'   # naranja (encabezado de categoría)
        _dh_name=$'\033[38;5;223m'    # crema (nombre del comando)
        _dh_dim=$'\033[38;5;245m'     # gris (plantilla de uso)
        _dh_reset=$'\033[0m'
    fi

    local _dh_data
    _dh_data="$(_dothelp_emit)"

    # Menú interactivo solo si: hay fzf, es terminal (stdin+stdout) y sin filtro.
    # Cualquier otro caso (filtro explícito, pipe, sin fzf) → listado estático.
    if [[ -z "$_dh_filter" && -t 1 && -t 0 ]] && command -v fzf &>/dev/null; then
        _dothelp_menu "$_dh_data"
    else
        _dothelp_static "$_dh_filter" "$_dh_data"
    fi
}

# ==============================================================================
# PTYXIS — sincronizar config de la terminal (dconf <-> repo)
# ==============================================================================
# Ptyxis guarda su config en dconf: estos helpers vuelcan y restauran terminal/ptyxis.dconf.

# --- [dotfiles] ptyxis-save: vuelca la config de Ptyxis (dconf) al repo | uso: ptyxis-save ---
ptyxis-save() {
    local dump="$HOME/.dotfiles/terminal/ptyxis.dconf"
    if ! command -v dconf &>/dev/null; then
        echo "dconf no esta disponible"
        return 1
    fi
    dconf dump /org/gnome/Ptyxis/ > "$dump" && echo "Ptyxis -> $dump"
}

# --- [dotfiles] ptyxis-load: restaura la config de Ptyxis (dconf) desde el repo | uso: ptyxis-load ---
ptyxis-load() {
    local dump="$HOME/.dotfiles/terminal/ptyxis.dconf"
    if ! command -v dconf &>/dev/null; then
        echo "dconf no esta disponible"
        return 1
    fi
    if [[ ! -f "$dump" ]]; then
        echo "No existe $dump"
        return 1
    fi
    dconf load /org/gnome/Ptyxis/ < "$dump" && echo "Restaurado desde $dump"
}

# ==============================================================================
# GNOME — sincronizar configuracion del escritorio (dconf <-> repo)
# ==============================================================================
# GNOME guarda su config en dconf (no en archivos): gnome-save la vuelca al repo y
# gnome-load la restaura. Una rama nueva se agrega a _GNOME_DCONF_MAP
# ("ruta/dconf/:archivo.dconf"). 'dconf load' es ADITIVO; las apps pineadas
# (favorite-apps) no se versionan: son estado personal.

# Mapa "rama dconf : archivo en gnome/" (relativo a ~/.dotfiles/gnome/)
_GNOME_DCONF_MAP=(
    "/org/gnome/settings-daemon/plugins/media-keys/:media-keys.dconf"
    "/org/gnome/desktop/wm/keybindings/:wm-keybindings.dconf"
    "/org/gnome/shell/extensions/dash-to-dock/:dash-to-dock.dconf"
    "/org/gnome/shell/extensions/blur-my-shell/:blur-my-shell.dconf"
    "/org/gnome/shell/:shell.dconf"
)

# --- [dotfiles] gnome-save: vuelca la config de GNOME (dconf) al repo | uso: gnome-save ---
gnome-save() {
    local dir="$HOME/.dotfiles/gnome"
    if ! command -v dconf &>/dev/null; then
        echo "dconf no esta disponible"
        return 1
    fi
    local entry path file
    for entry in "${_GNOME_DCONF_MAP[@]}"; do
        path="${entry%%:*}"
        file="${entry##*:}"
        # shell.dconf se mantiene a mano (solo claves selectas), no se vuelca entero
        if [[ "$file" == "shell.dconf" ]]; then
            echo "omitido  $file (editar a mano: rama ruidosa)"
            continue
        fi
        dconf dump "$path" > "$dir/$file" && echo "guardado $file"
    done
}

# --- [dotfiles] gnome-load: restaura la config de GNOME (dconf) desde el repo | uso: gnome-load ---
gnome-load() {
    local dir="$HOME/.dotfiles/gnome"
    if ! command -v dconf &>/dev/null; then
        echo "dconf no esta disponible"
        return 1
    fi
    local entry path file
    for entry in "${_GNOME_DCONF_MAP[@]}"; do
        path="${entry%%:*}"
        file="${entry##*:}"
        if [[ -f "$dir/$file" ]]; then
            dconf load "$path" < "$dir/$file" && echo "restaurado $file"
        else
            echo "falta    $file (no existe en el repo)"
        fi
    done
}

# ==============================================================================
# BATERIA — limite de carga (Lenovo conservation mode)
# ==============================================================================
# Conservation mode del EC (driver ideapad_laptop): on topa la carga en ~80%, off carga
# al 100%. La ruta sysfs se resuelve con find porque la numeracion PCI varia.

# --- [sistema] battery-limit: ver/activar/desactivar el tope de carga (Lenovo) | uso: battery-limit [status|on|off] ---
battery-limit() {
    local cm
    cm=$(find /sys/devices -name conservation_mode 2>/dev/null | head -1)
    if [[ -z "$cm" ]]; then
        echo "conservation_mode no disponible (¿no es un Lenovo ideapad?)"
        return 1
    fi
    case "${1:-status}" in
        on)
            echo 1 | sudo tee "$cm" >/dev/null && echo "Tope de carga ACTIVADO (~80%)"
            ;;
        off)
            echo 0 | sudo tee "$cm" >/dev/null && echo "Tope de carga DESACTIVADO (carga al 100%)"
            ;;
        status)
            local cap; cap=$(cat /sys/class/power_supply/BAT0/capacity 2>/dev/null)
            local st;  st=$(cat /sys/class/power_supply/BAT0/status 2>/dev/null)
            if [[ "$(cat "$cm")" == "1" ]]; then
                echo "Tope: ON (~80%)  |  carga: ${cap}%  |  estado: ${st}"
            else
                echo "Tope: OFF (100%)  |  carga: ${cap}%  |  estado: ${st}"
            fi
            ;;
        *)
            echo "Uso: battery-limit [status|on|off]"
            return 1
            ;;
    esac
}

# --- [sistema] _aviso_fedora_nueva: avisa (sin actualizar) si ya salio la proxima Fedora ---
# La proxima version esta publicada cuando su repo de releases responde 200.
_aviso_fedora_nueva() {
    local _ver_actual _ver_nueva _gnome _azul _violeta _gris _reset _ico_fedora _ico_gnome
    _ver_actual=$(. /etc/os-release 2>/dev/null && [[ "$ID" == fedora ]] && echo "$VERSION_ID")
    [[ -n "$_ver_actual" ]] || return 0
    _ver_nueva=$((_ver_actual + 1))
    curl -fsI -m 5 -o /dev/null \
        "https://dl.fedoraproject.org/pub/fedora/linux/releases/${_ver_nueva}/Everything/$(uname -m)/os/repodata/repomd.xml" || return 0
    _gnome=$(curl -fs -m 5 "https://bodhi.fedoraproject.org/updates/?releases=F${_ver_nueva}&packages=gnome-shell&status=stable&rows_per_page=1" \
        | grep -oE 'gnome-shell-[0-9]+\.[0-9]+' | head -1 | sed 's/gnome-shell-//')
    _azul=$'\033[38;2;81;162;218m'; _violeta=$'\033[38;2;192;132;252m'
    _gris=$'\033[38;5;245m'; _reset=$'\033[0m'
    _ico_fedora=$'\uf30a'; _ico_gnome=$'\uf2bc'
    echo
    printf '%s▌%s %s%s Fedora %s%s' "$_azul" "$_reset" "$_azul" "$_ico_fedora" "$_ver_nueva" "$_reset"
    [[ -n "$_gnome" ]] && printf '  %s· %s GNOME %s%s' "$_violeta" "$_ico_gnome" "$_gnome" "$_reset"
    printf '  ya disponible\n'
    printf '%s▌ No se actualiza sola; cuando decidas, corre:%s\n' "$_azul" "$_reset"
    printf '%s▌%s   sudo dnf upgrade --refresh\n' "$_azul" "$_reset"
    printf '%s▌%s   sudo dnf system-upgrade download --releasever=%s\n' "$_azul" "$_reset" "$_ver_nueva"
    printf '%s▌%s   sudo dnf offline reboot\n' "$_azul" "$_reset"
    printf '%s▌ Tip: conviene esperar 2-4 semanas tras el lanzamiento.%s\n' "$_gris" "$_reset"
}

# --- [sistema] update-all: actualiza todo lo que dnf no cubre | uso: update-all ---
# Recorre los gestores que dnf no cubre: Flatpak, npm, Claude Code y OpenLogi.
update-all() {
    if command -v dnf &>/dev/null; then
        echo "==> dnf (paquetes del sistema)"
        sudo dnf upgrade -y
    fi
    if command -v flatpak &>/dev/null; then
        echo "==> flatpak (apps de Flathub)"
        flatpak update -y
    fi
    if command -v npm &>/dev/null; then
        echo "==> npm (paquetes globales, p.ej. codex)"
        npm update -g
    fi
    # 'claude update' no hace nada si ya esta al dia.
    if command -v claude &>/dev/null; then
        echo "==> claude (Claude Code)"
        claude update
    fi
    # OpenLogi se instala con rpm desde un release de GitHub: dnf no lo ve.
    if command -v openlogi &>/dev/null && command -v rpm &>/dev/null; then
        echo "==> openlogi (mouse MX, release de GitHub)"
        local _ol_cur _ol_new _ol_url _ol_tmp
        _ol_cur=$(rpm -q --qf '%{VERSION}' openlogi 2>/dev/null)
        _ol_new=$(curl -fsSL "https://api.github.com/repos/AprilNEA/OpenLogi/releases/latest" \
            | grep -oE '"tag_name": *"v?[^"]+"' | head -1 | grep -oE '[0-9][^"]*')
        if [[ -z "$_ol_new" ]]; then
            echo "   no se pudo consultar el ultimo release (sin red?), salteado"
        elif [[ "$_ol_cur" == "$_ol_new" ]]; then
            echo "   ya en la ultima ($_ol_cur)"
        else
            echo "   actualizando $_ol_cur -> $_ol_new"
            _ol_tmp=$(mktemp -d)
            _ol_url=$(curl -fsSL "https://api.github.com/repos/AprilNEA/OpenLogi/releases/latest" \
                | grep -oE 'https://[^"]+linux-amd64\.rpm' | head -1)
            if curl -fsSL "$_ol_url" -o "$_ol_tmp/openlogi.rpm"; then
                sudo rpm -U --replacepkgs "$_ol_tmp/openlogi.rpm" \
                    && systemctl --user restart openlogi-agent.service 2>/dev/null
            fi
            rm -rf "$_ol_tmp"
        fi
    fi
    # Tras actualizar kernel/glibc/systemd los procesos siguen con las libs viejas.
    # needs-restarting -r devuelve 1 si hace falta reiniciar; si no esta, se compara el kernel.
    echo "==> chequeo de reinicio"
    if command -v needs-restarting &>/dev/null; then
        if ! needs-restarting -r &>/dev/null; then
            echo "   ⚠  Hace falta REINICIAR (kernel/libs base actualizadas). Corre: systemctl reboot"
        else
            echo "   no hace falta reiniciar"
        fi
    elif command -v uname &>/dev/null && command -v rpm &>/dev/null; then
        local _krun _klast
        _krun=$(uname -r)
        _klast=$(rpm -q --last kernel 2>/dev/null | head -1 | grep -oE 'kernel-[^ ]+' | sed 's/^kernel-//')
        if [[ -n "$_klast" && "$_krun" != "$_klast" ]]; then
            echo "   ⚠  Kernel corriendo ($_krun) != ultimo instalado ($_klast). Corre: systemctl reboot"
        else
            echo "   kernel al dia"
        fi
    fi
    echo "Listo. Nota: lazyssh y lazysql (binarios GitHub) y los instalados por curl"
    echo "(oh-my-posh, zoxide, opencode) se actualizan aparte."
    _aviso_fedora_nueva
}

# ==============================================================================
# BLE.SH — paleta de colores (faces), espejo de los -Colors de PSReadLine
# ------------------------------------------------------------------------------
# Command #C79BFF · Parameter #7AB8FF · String #86E89A · Variable #FFDF61
# Operator #56B6C2 · Error #FF7A7A · Comment/InlinePrediction #6B5448 · directorios
# #D4874E (LS_COLORS di=172). Se setean antes del primer prompt, donde ble.sh se adjunta.
# ==============================================================================

if [[ -n "${BLE_VERSION:-}" ]]; then
    # Comandos (funciones, builtins, alias, ejecutables, keywords) → purpura
    ble-face -s command_function 'fg=#C79BFF'
    ble-face -s command_builtin  'fg=#C79BFF'
    ble-face -s command_alias    'fg=#C79BFF'
    ble-face -s command_file     'fg=#C79BFF'
    ble-face -s command_keyword  'fg=#C79BFF,bold'
    # Directorios (cd a una carpeta) → naranja, como LS_COLORS
    ble-face -s command_directory  'fg=#D4874E'
    ble-face -s filename_directory 'fg=#D4874E'
    # Opciones/argumentos (--flag) → azul
    ble-face -s argument_option 'fg=#7AB8FF'
    # Strings (comillas) → verde
    ble-face -s syntax_quoted    'fg=#86E89A'
    ble-face -s syntax_quotation 'fg=#86E89A'
    # Variables / expansiones ($VAR, ${...}) → amarillo
    ble-face -s syntax_varname        'fg=#FFDF61'
    ble-face -s syntax_param_expansion 'fg=#FFDF61'
    # Operadores / delimitadores (| && > ;) → cyan
    ble-face -s syntax_delimiter 'fg=#56B6C2'
    # Errores (comando inexistente, sintaxis rota) → rojo
    ble-face -s syntax_error   'fg=#FF7A7A'
    ble-face -s argument_error 'fg=#FF7A7A'
    # Comentarios → tenue
    ble-face -s syntax_comment 'fg=#6B5448'
    # Autosugerencia del historial (espejo de InlinePrediction) → gris calido
    ble-face -s auto_complete 'fg=#6B5448'

    # Sugerencia desde el historial mientras escribis (como PSReadLine prediction)
    bleopt complete_auto_complete=1

    # El exit code ya lo muestra el segmento 'status' de oh-my-posh.
    bleopt exec_errexit_mark=

    # El prompt de oh-my-posh es multilinea: sin esto ble.sh redibuja solo la ultima linea
    # y el prompt se duplica.
    bleopt prompt_command_changes_layout=1
fi

