# --- [git] gup: set upstream (origin) de la rama actual | uso: gup ---
gup() {
    local branch
    branch="$(git rev-parse --abbrev-ref HEAD)"
    git branch --set-upstream-to="origin/$branch" "$branch"
}

# --- [git] gpsu: push inicial de la rama con tracking a origin | uso: gpsu ---
gpsu() {
    local branch
    branch="$(git rev-parse --abbrev-ref HEAD)"
    git push -u origin "$branch"
}

# --- [git] gsync: fetch --all --prune + pull --rebase --autostash | uso: gsync ---
gsync() {
    git fetch --all --prune
    git pull --rebase --autostash
}

# --- [git] gsw: smart switch, crea la rama si no existe (local o remota) | uso: gsw <rama> ---
gsw() {
    local branch="$1"
    if [[ -z "$branch" ]]; then
        echo "Uso: gsw <rama>"
        return 1
    fi

    git fetch --prune &>/dev/null
    if git show-ref --verify --quiet "refs/heads/$branch"; then
        git switch "$branch"
    elif git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
        git switch -t "origin/$branch"
    else
        git switch -c "$branch"
    fi
}

# --- [git] gfixup: commit --fixup sobre un commit (HEAD por defecto) | uso: gfixup [commit] ---
gfixup() {
    git commit --fixup "${1:-HEAD}"
}

# --- [git] gundo: deshace el último commit y conserva los cambios | uso: gundo ---
gundo() {
    git reset --soft HEAD~1
}

# --- [git] gclean: elimina archivos sin trackear (pide confirmación) | uso: gclean ---
gclean() {
    echo "Archivos que se eliminarian:"
    git clean -fd --dry-run
    read -rp "Continuar? [y/N] " confirm
    [[ "$confirm" =~ ^[yY]$ ]] && git clean -fd
}

# --- [git] gprune: borra ramas locales ya mergeadas | uso: gprune ---
gprune() {
    git fetch --prune
    git branch --merged | grep -v '\*\|main\|master\|develop' | xargs -r git branch -d
}

# --- [git] gcleanbranches: borra ramas cuyo upstream remoto ya no existe | uso: gcleanbranches ---
gcleanbranches() {
    git fetch --prune
    local gone
    gone=$(git branch -vv | awk '/: gone\]/{print $1}')
    if [[ -z "$gone" ]]; then
        echo "Sin branches para limpiar."
        return 0
    fi
    echo "$gone" | xargs -r git branch -d
}

# --- [git] gcoi: checkout interactivo de ramas con fzf | uso: gcoi ---
gcoi() {
    if ! command -v fzf &>/dev/null; then
        echo "fzf no esta instalado"
        return 1
    fi
    local branch
    branch=$(git branch --all | fzf --height 40% --border | sed 's/^[* ]*//' | sed 's|remotes/origin/||')
    [[ -n "$branch" ]] && git checkout "$branch"
}

# --- [git] gwork: cd al directorio de trabajo ($work o el indicado) | uso: gwork [dir] ---
gwork() {
    local dir="${1:-$work}"
    cd "$dir" || return 1
}

# ==============================================================================
# PUERTOS (dev workflow)
# ==============================================================================

# --- [sistema] port: lista el proceso que escucha en un puerto | uso: port <puerto> ---
port() {
    local p="${1:?Uso: port <puerto>}"
    if command -v lsof &>/dev/null; then
        lsof -nP -iTCP:"$p" -sTCP:LISTEN
    else
        ss -ltnp "sport = :$p"
    fi
}

# --- [sistema] killport: mata el proceso que escucha en un puerto | uso: killport <puerto> ---
killport() {
    local p="${1:?Uso: killport <puerto>}"
    local pid
    if command -v lsof &>/dev/null; then
        pid=$(lsof -nP -iTCP:"$p" -sTCP:LISTEN -t | head -n1)
    else
        pid=$(ss -ltnp "sport = :$p" 2>/dev/null | grep -oP 'pid=\K[0-9]+' | head -n1)
    fi
    if [[ -z "$pid" ]]; then
        echo "Nada escuchando en puerto $p"
        return 0
    fi
    kill -9 "$pid" && echo "Killed PID $pid (puerto $p)"
}

# --- [sistema] killdev: mata procesos en puertos comunes de desarrollo | uso: killdev ---
killdev() {
    local devports=(3000 3001 4200 5173 8080 8090 8443)
    for p in "${devports[@]}"; do
        killport "$p"
    done
}

# Deja la lista en memoria igual al archivo de historial.
# --- [dotfiles] _reload_history: (interna) recarga el historial de la sesion desde el archivo | uso: _reload_history ---
_reload_history() {
    local hist="${HISTFILE:-$HOME/.bash_history}"
    history -c              # vacia la lista en memoria
    history -r "$hist"      # relee el archivo
    return 0
}

# Sin args vacia todo (con confirmacion); con un texto borra solo las lineas que lo contengan.
# --- [dotfiles] clear-history: vacía el historial completo, o borra las líneas que contengan un texto | uso: clear-history [texto] ---
clear-history() {
    local hist="${HISTFILE:-$HOME/.bash_history}"
    # Un argumento vacio (variable sin definir) no es 'sin args': abortar en vez de vaciar todo.
    if (( $# > 0 )) && [[ -z "$1" ]]; then
        echo "clear-history: el patron esta vacio (variable sin definir?). Abortado." >&2
        echo "  Para vaciar TODO el historial, corre 'clear-history' sin argumentos." >&2
        return 1
    fi
    # Rechaza el placeholder del uso pegado tal cual ([texto], <texto>).
    if [[ "$1" == \[*\] || "$1" == \<*\> ]]; then
        echo "clear-history: '$1' parece el placeholder del formato, no un texto real." >&2
        echo "  Uso: clear-history [texto]   (ej: clear-history TOKEN)" >&2
        return 1
    fi
    if [[ -n "$1" ]]; then
        # -F: patron literal; como regex un token con . * [ ] borraria de mas.
        local borradas
        borradas=$(grep -cF -- "$1" "$hist" 2>/dev/null) || borradas=0
        if (( borradas == 0 )); then
            echo "Historial: ninguna linea contiene '$1'. Nada que borrar."
            return 0
        fi
        grep -vF -- "$1" "$hist" > "${hist}.tmp"
        # grep devuelve 1 si no selecciona ninguna linea: el error real es rc > 1.
        local rc=$?
        if (( rc > 1 )); then
            rm -f "${hist}.tmp"
            echo "clear-history: fallo al filtrar $hist (no se borro nada)." >&2
            return 1
        fi
        mv "${hist}.tmp" "$hist"
        _reload_history                  # recarga el historial limpio
        echo "Historial: borradas $borradas linea(s) que contenian '$1'."
    else
        printf 'Vaciar TODO el historial (%s)? [y/N] ' "$hist"
        local ans; read -r ans
        if [[ "$ans" == [yY] ]]; then
            : > "$hist"          # vacia el archivo
            _reload_history      # limpia la memoria de la sesion
            echo "Historial vaciado."
        else
            echo "Cancelado."
        fi
    fi
}

# La sesion actual reescribe el archivo al salir: editarlo en vivo puede pisarse.
# --- [dotfiles] edit-history: abre el archivo de historial en el editor | uso: edit-history ---
edit-history() {
    edit "${HISTFILE:-$HOME/.bash_history}"
}

# exec reemplaza el proceso: no anida otro shell.
# --- [dotfiles] reload: reinicia el shell (relee la config, sin anidar shells) | uso: reload ---
reload() {
    exec bash
}

# Borra lo regenerable de ~/.claude con preview y confirmacion. No toca CLAUDE.md, settings,
# credenciales, skills, plugins ni la memoria. Las conversaciones, solo con --days N.
# --- [dotfiles] claude-clean: limpia historial, caches y sesiones viejas de ~/.claude | uso: claude-clean [-n] [-y] [--days N] ---
claude-clean() {
    local dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
    local dry=0 yes=0 days="" targets="" p f k pid kb ans total=0 n=0
    while (( $# )); do
        case "$1" in
            -n|--dry-run) dry=1 ;;
            -y|--yes) yes=1 ;;
            -d|--days)
                days="${2:-}"
                if ! [[ "$days" =~ ^[0-9]+$ ]]; then
                    echo "claude-clean: --days necesita un numero de dias." >&2
                    return 1
                fi
                shift ;;
            -h|--help)
                echo "uso: claude-clean [-n|--dry-run] [-y|--yes] [-d|--days N]"
                echo "  -n  solo mostrar, no borrar"
                echo "  -y  no pedir confirmacion"
                echo "  -d  ademas borrar conversaciones (projects/*/*.jsonl) de mas de N dias"
                return 0 ;;
            *) echo "claude-clean: opcion desconocida '$1' (ver --help)." >&2; return 1 ;;
        esac
        shift
    done
    [[ -d "$dir" ]] || { echo "claude-clean: no existe $dir" >&2; return 1; }

    # Regenerables: Claude los vuelve a crear cuando los necesita.
    for p in history.jsonl stats-cache.json file-history paste-cache shell-snapshots \
             session-env plugins/plugin-catalog-cache.json plugins/plugin-directory-cache-v2.json; do
        [[ -e "$dir/$p" ]] && targets+="$dir/$p"$'\n'
    done
    # Backups de ~/.claude.json: todos menos el mas reciente.
    if [[ -d "$dir/backups" ]]; then
        while IFS= read -r f; do
            [[ -n "$f" ]] && targets+="$dir/backups/$f"$'\n'
        done < <(ls -1t "$dir/backups" 2>/dev/null | tail -n +2)
    fi
    # Registros de sesion (<pid>.json + <pid>.*.key) cuyo proceso ya no existe.
    while IFS= read -r f; do
        pid="${f##*/}"; pid="${pid%.json}"
        if ! kill -0 "$pid" 2>/dev/null; then
            targets+="$f"$'\n'
            while IFS= read -r k; do
                targets+="$k"$'\n'
            done < <(find "$dir/sessions" -maxdepth 1 -name "$pid.*.key" 2>/dev/null)
        fi
    done < <(find "$dir/sessions" -maxdepth 1 -name '*.json' 2>/dev/null)
    # Conversaciones viejas (y su carpeta de adjuntos): solo si se pidio --days.
    if [[ -n "$days" ]]; then
        while IFS= read -r f; do
            targets+="$f"$'\n'
            [[ -d "${f%.jsonl}" ]] && targets+="${f%.jsonl}"$'\n'
        done < <(find "$dir/projects" -mindepth 2 -maxdepth 2 -name '*.jsonl' -mtime +"$days" 2>/dev/null)
    fi

    if [[ -z "$targets" ]]; then
        echo "Nada que limpiar en $dir."
        return 0
    fi
    echo "Se borraria de $dir:"
    while IFS= read -r p; do
        [[ -z "$p" ]] && continue
        kb=$(du -sk -- "$p" 2>/dev/null | cut -f1)
        kb=${kb:-0}
        total=$((total + kb)); n=$((n + 1))
        printf '  %8s KB  %s\n' "$kb" "${p#"$dir"/}"
    done <<< "$targets"
    echo "Total: $n elemento(s), $(awk -v k="$total" 'BEGIN{printf "%.1f", k/1024}') MB."
    pgrep -x claude >/dev/null 2>&1 && echo "Aviso: hay sesiones de Claude abiertas; lo que usen ahora puede regenerarse."

    if (( dry )); then
        echo "(dry-run: no se borro nada)"
        return 0
    fi
    if (( ! yes )); then
        printf 'Borrar? [y/N] '
        read -r ans
        [[ "$ans" == [yY] ]] || { echo "Cancelado."; return 0; }
    fi
    while IFS= read -r p; do
        [[ -n "$p" ]] && rm -rf -- "$p"
    done <<< "$targets"
    echo "Listo: liberados ~$(awk -v k="$total" 'BEGIN{printf "%.1f", k/1024}') MB."
}

# ==============================================================================
# GIT — CLONE + PERFILES DE IDENTIDAD
# ==============================================================================

# Las identidades viven en el vault; el bootstrap las copia a ~/.config/git-identities.sh.
_GIT_IDENTITIES_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/git-identities.sh"
# Declarar todos los arrays asociativos que el vault asigna: sin declarar, la clave se
# evalua como aritmetica y el source aborta.
declare -gA GIT_IDENTITIES_NAME GIT_IDENTITIES_EMAIL GIT_SSH_ALIASES
# Declarado para que _infer_git_profile no falle sin vault.
declare -ga GIT_PROFILE_REMOTES
if [[ -f "$_GIT_IDENTITIES_FILE" ]]; then
    . "$_GIT_IDENTITIES_FILE"
fi

# Deja nombre/email en _gi_name/_gi_email; 1 si el perfil no existe o falta el vault.
# --- [git] _resolve_identity: (interna) resuelve nombre/email de un perfil git | uso: _resolve_identity <perfil> ---
_resolve_identity() {
    local perfil="$1"
    _gi_name="${GIT_IDENTITIES_NAME[$perfil]:-}"
    _gi_email="${GIT_IDENTITIES_EMAIL[$perfil]:-}"
    if [[ -z "$_gi_name" || -z "$_gi_email" ]]; then
        if [[ ${#GIT_IDENTITIES_EMAIL[@]} -eq 0 ]]; then
            echo "Error: identidades git no cargadas (falta el vault: $_GIT_IDENTITIES_FILE)" >&2
        else
            echo "Error: perfil desconocido '$perfil'" >&2
            echo "Perfiles validos: ${!GIT_IDENTITIES_EMAIL[*]}" >&2
        fi
        return 1
    fi
    return 0
}

# Acepta 'git@host:ns/repo' o URL con esquema; vacio si no la reconoce.
# --- [git] _git_url_host: (interna) extrae el host de una URL de git | uso: _git_url_host <url> ---
_git_url_host() {
    local url="$1" host=""
    case "$url" in
        *://*)  host="${url#*://}"; host="${host#*@}"; host="${host%%/*}"; host="${host%%:*}" ;;
        *@*:*)  host="${url#*@}";   host="${host%%:*}" ;;
    esac
    printf '%s' "$host"
}

# Deja el perfil en _gi_profile y su origen en _gi_profile_src. Orden: host del remoto
# contra GIT_PROFILE_REMOTES, luego la carpeta ~/repositorios/<ctx>.
# --- [git] _infer_git_profile: (interna) deduce el perfil git de un remoto/carpeta | uso: _infer_git_profile <url> <dir> ---
_infer_git_profile() {
    local url="$1" dir="$2"
    _gi_profile=""; _gi_profile_src=""

    local host entry entry_host
    host="$(_git_url_host "$url")"
    if [[ -n "$host" && ${#GIT_PROFILE_REMOTES[@]} -gt 0 ]]; then
        for entry in "${GIT_PROFILE_REMOTES[@]}"; do
            entry_host="$(_git_url_host "${entry%%|*}")"
            if [[ -n "$entry_host" && "$entry_host" == "$host" ]]; then
                _gi_profile="${entry#*|}"; _gi_profile="${_gi_profile%%|*}"
                _gi_profile_src="host-alias del remoto ($host)"
                return 0
            fi
        done
    fi

    local ctx=""
    case "$dir" in
        "$HOME"/repositorios/*) ctx="${dir#"$HOME"/repositorios/}"; ctx="${ctx%%/*}" ;;
    esac
    if [[ -n "$ctx" ]]; then
        if [[ -n "${GIT_IDENTITIES_EMAIL[$ctx]:-}" ]]; then
            _gi_profile="$ctx"
        elif [[ -f "$HOME/.gitconfig-$ctx" ]]; then
            local ctx_mail p
            ctx_mail="$(git config --file "$HOME/.gitconfig-$ctx" user.email 2>/dev/null)"
            # Orden estable: dos perfiles pueden compartir email (misma identidad
            # en dos plataformas) y el recorrido de un hash no tiene orden.
            if [[ -n "$ctx_mail" ]]; then
                while read -r p; do
                    if [[ "${GIT_IDENTITIES_EMAIL[$p]}" == "$ctx_mail" ]]; then
                        _gi_profile="$p"; break
                    fi
                done < <(printf '%s\n' "${!GIT_IDENTITIES_EMAIL[@]}" | sort)
            fi
        fi
        [[ -n "$_gi_profile" ]] && _gi_profile_src="carpeta de contexto ($ctx)"
    fi

    [[ -n "$_gi_profile" ]]
}

_gclone_usage() {
    # Las claves van a una variable aparte: '${!ARR[*]:-x}' se lee como indireccion y falla.
    local perfiles="${!GIT_IDENTITIES_EMAIL[*]}"
    echo "Uso: gclone <url> [dir] [-p <perfil>]"
    echo "  dir  si existe, se clona DENTRO (dir/<repo>); si no, es el destino exacto."
    echo "  -p   opcional: sin el, el perfil se deduce del host-alias del remoto o"
    echo "       de la carpeta de contexto (~/repositorios/<ctx>)."
    echo "Perfiles: ${perfiles:-(vault no cargado)}"
}

# Tambien acepta -u/--url y -d/--dir.
# --- [git] gclone: clona un repo aplicando un perfil de identidad git | uso: gclone <url> [dir] [-p perfil] ---
gclone() {
    local perfil="" remote_url="" target_dir=""

    # Flags en cualquier orden y hasta dos posicionales (url, dir).
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -p|--perfil)  perfil="$2";     shift 2 ;;
            -u|--url)     remote_url="$2"; shift 2 ;;
            -d|--dir)     target_dir="$2"; shift 2 ;;
            -h|--help)    _gclone_usage; return 0 ;;
            -*)
                echo "Error: opcion desconocida '$1'" >&2
                _gclone_usage
                return 1
                ;;
            *)
                if   [[ -z "$remote_url" ]]; then remote_url="$1"
                elif [[ -z "$target_dir" ]]; then target_dir="$1"
                else
                    echo "Error: argumento de mas: '$1'" >&2
                    _gclone_usage
                    return 1
                fi
                shift
                ;;
        esac
    done

    if [[ -z "$remote_url" ]]; then
        echo "Error: falta la URL del repo" >&2
        _gclone_usage
        return 1
    fi

    # Un dir existente es el padre: se clona adentro.
    local repo_name
    repo_name="$(basename "$remote_url" .git)"
    local clone_dir
    if [[ -z "$target_dir" ]]; then
        clone_dir="$(pwd)/$repo_name"
    elif [[ -d "$target_dir" ]]; then
        clone_dir="${target_dir%/}/$repo_name"
    else
        clone_dir="$target_dir"
    fi

    # Perfil: explicito o inferido del remoto / la carpeta de contexto
    if [[ -z "$perfil" ]]; then
        if _infer_git_profile "$remote_url" "$clone_dir"; then
            perfil="$_gi_profile"
            echo "Perfil inferido: $perfil (por $_gi_profile_src)"
        else
            echo "Error: no pude inferir el perfil; pasalo con -p <perfil>" >&2
            _gclone_usage
            return 1
        fi
    fi

    # Avisar si el remoto SSH no usa un host-alias del vault: engancha la clave
    # por defecto en vez de la del perfil y el clone puede fallar.
    local url_host
    url_host="$(_git_url_host "$remote_url")"
    if [[ "$remote_url" != *://* && -n "$url_host" \
          && ${#GIT_SSH_ALIASES[@]} -gt 0 && -z "${GIT_SSH_ALIASES[$url_host]:-}" ]]; then
        echo "Aviso: '$url_host' no es un host-alias del vault; conviene usar el alias SSH del perfil." >&2
    fi

    local name="" email=""
    _resolve_identity "$perfil" || return 1
    name="$_gi_name"; email="$_gi_email"

    if [[ -d "$clone_dir" ]] && [[ -n "$(ls -A "$clone_dir" 2>/dev/null)" ]]; then
        echo "Error: el destino ya existe y no esta vacio: $clone_dir"
        return 1
    fi

    echo "Clonando $remote_url en $clone_dir ..."
    if ! git clone "$remote_url" "$clone_dir"; then
        echo "Error: fallo el clone"
        return 1
    fi

    (
        cd "$clone_dir" || return 1
        git config --local user.useConfigOnly true
        git config --local user.name          "$name"
        git config --local user.email         "$email"
        git config --local core.autocrlf      input
        git config --local pull.rebase        true
        git config --local rebase.autostash   true
    )

    echo ""
    echo "Repositorio: $repo_name"
    echo "Path:        $clone_dir"
    echo "Perfil:      $perfil"
    echo "User:        $name <$email>"
    echo "Remote:      $(cd "$clone_dir" && git remote get-url origin 2>/dev/null)"
}

# --- [git] gset-profile: aplica un perfil de identidad git a un repo existente | uso: gset-profile <perfil> ---
gset-profile() {
    local perfil="$1"
    if [[ -z "$perfil" ]]; then
        # Ver _gclone_usage.
        local perfiles="${!GIT_IDENTITIES_EMAIL[*]}"
        echo "Uso: gset-profile <perfil>"
        echo "Perfiles: ${perfiles:-(vault no cargado)}"
        return 1
    fi

    if ! git rev-parse --is-inside-work-tree &>/dev/null; then
        echo "Error: no es un repo Git"
        return 1
    fi

    local name="" email=""
    _resolve_identity "$perfil" || return 1
    name="$_gi_name"; email="$_gi_email"

    git config --local user.name  "$name"
    git config --local user.email "$email"
    echo "Perfil '$perfil' aplicado: $name <$email>"
}

# --- [git] ginit: git init con perfil de identidad + .gitignore y AGENTS.md base | uso: ginit <perfil> [path] ---
ginit() {
    local perfil="$1"
    # No llamarla 'path': en zsh esta ligada a $PATH.
    local dir="${2:-$PWD}"

    if [[ -z "$perfil" ]]; then
        # Ver _gclone_usage.
        local perfiles="${!GIT_IDENTITIES_EMAIL[*]}"
        echo "Uso: ginit <perfil> [path]"
        echo "Perfiles: ${perfiles:-(vault no cargado)}"
        return 1
    fi

    if [[ ! -d "$dir" ]]; then
        echo "Error: $dir no existe"
        return 1
    fi

    (
        cd "$dir" || exit 1
        if [[ ! -d .git ]]; then
            git init -b main >/dev/null
        fi
        gset-profile "$perfil" || exit 1
        git config --local --unset-all pull.rebase        2>/dev/null
        git config --local --unset-all init.defaultbranch 2>/dev/null
        git config --local --unset-all core.autocrlf      2>/dev/null
        git config --local --unset-all core.editor        2>/dev/null
        # .gitignore base si el repo no tiene uno.
        local _tpl="$HOME/.dotfiles/git/gitignore-proyecto"
        if [[ ! -f .gitignore && -f "$_tpl" ]]; then
            cp "$_tpl" .gitignore
            echo ".gitignore base creado (plantilla de dotfiles — suma lo de tu stack)"
        fi
        # AGENTS.md base si falta.
        local _agents="$HOME/.dotfiles/git/agents-proyecto.md"
        if [[ ! -f AGENTS.md && -f "$_agents" ]]; then
            cp "$_agents" AGENTS.md
            echo "AGENTS.md base creado (plantilla de dotfiles — completalo con el agente)"
        fi
        # Sensor de secretos (pre-commit con gitleaks) si el repo no trae hooks propios.
        if [[ -x "$HOME/.dotfiles/git/hooks/pre-commit" ]] && ! git config --local --get core.hooksPath >/dev/null; then
            git config --local core.hooksPath '~/.dotfiles/git/hooks'
            echo "Sensor de secretos activado (pre-commit de dotfiles)"
        fi
        exit 0
    )
}

# Ejemplo: gremote gitlab.com-<alias> grupo/proyecto origin
# --- [git] gremote: agrega un remote usando un alias SSH | uso: gremote <alias-ssh> <namespace/repo> [nombre-remote] ---
gremote() {
    local alias_host="$1"
    local path_ns="$2"
    local name="${3:-origin}"

    if [[ -z "$alias_host" || -z "$path_ns" ]]; then
        echo "Uso: gremote <alias-ssh> <namespace/repo> [nombre-remote]"
        return 1
    fi

    local ssh="git@${alias_host}:${path_ns}.git"

    if git remote get-url "$name" &>/dev/null; then
        git remote set-url "$name" "$ssh"
    else
        git remote add "$name" "$ssh"
    fi
    echo "Remote '$name' → $ssh"
}

# ==============================================================================
# SSH KEYS — dar de alta y sincronizar claves del vault (paridad zsh/ps1)
# ------------------------------------------------------------------------------
# El vault versiona las claves SSH cifradas con age, su .pub y el ssh/config.
# ssh-newkey da de alta una clave; vault-sync trae los cambios a esta maquina.
# ==============================================================================

VAULT_DIR="${VAULT_DIR:-$HOME/.dotfiles-vault}"

# Deja el 'git add' hecho; el commit y el push son manuales.
# --- [ssh] ssh-newkey: genera un par de claves SSH nuevo (cifra con age) | uso: ssh-newkey <nombre> ---
ssh-newkey() {
    local name="$1"
    if [[ -z "$name" ]]; then
        echo "Uso: ssh-newkey <nombre>   (ej: ssh-newkey miserver)" >&2
        return 1
    fi
    command -v age &>/dev/null || { echo "Falta 'age' (bootstrap: --tools=age)" >&2; return 1; }
    command -v ssh-keygen &>/dev/null || { echo "Falta 'ssh-keygen'" >&2; return 1; }
    [[ -d "$VAULT_DIR/ssh/keys" ]] || { echo "No existe $VAULT_DIR/ssh/keys (falta el vault?)" >&2; return 1; }

    local key="$HOME/.ssh/$name"
    local age_file="$VAULT_DIR/ssh/keys/$name.age"
    if [[ -e "$key" || -e "$age_file" ]]; then
        echo "Ya existe una clave '$name' (en ~/.ssh o en el vault). Elegi otro nombre." >&2
        return 1
    fi

    # 1) Generar el par (sin passphrase en la privada: la protege age en el vault)
    ssh-keygen -t ed25519 -f "$key" -N '' -C "$name-$(hostname)" || return 1
    chmod 600 "$key"; chmod 644 "$key.pub"

    # 2) Encriptar la privada con age (pide passphrase interactiva — la tipeas vos)
    echo "Encriptando la clave con age (usa la MISMA passphrase que las otras del vault):"
    if ! age -p -o "$age_file" "$key"; then
        echo "Fallo el encriptado con age. Limpiando." >&2
        rm -f "$key" "$key.pub" "$age_file"
        return 1
    fi
    # 3) Copiar la publica al vault
    cp "$key.pub" "$VAULT_DIR/ssh/keys/$name.pub"

    # 4) Datos del Host para el ssh/config (opcional)
    local host hostname user port
    printf 'Alias/Host para ssh/config [%s] (vacio = no agregar): ' "$name"
    read -r host
    if [[ -n "$host" ]]; then
        printf 'HostName (IP o dominio): ';        read -r hostname
        printf 'Usuario remoto: ';                 read -r user
        printf 'Puerto [22]: ';                    read -r port
        {
            printf '\n# %s\n' "$name"
            printf 'Host %s\n'          "$host"
            printf '    HostName %s\n'  "${hostname:-CAMBIAME}"
            printf '    User %s\n'      "${user:-CAMBIAME}"
            [[ -n "$port" && "$port" != "22" ]] && printf '    Port %s\n' "$port"
            printf '    IdentityFile ~/.ssh/%s\n' "$name"
            printf '    IdentitiesOnly yes\n'
        } >> "$VAULT_DIR/ssh/config"
        # Reflejar en el config activo de esta maquina (bootstrap lo copia, no linkea)
        cp "$VAULT_DIR/ssh/config" "$HOME/.ssh/config" && chmod 600 "$HOME/.ssh/config"
        echo "Host '$host' agregado a ssh/config (vault y ~/.ssh)."
    fi

    # 5) Dejar el git add listo (commit/push manual)
    git -C "$VAULT_DIR" add "ssh/keys/$name.age" "ssh/keys/$name.pub" ssh/config 2>/dev/null
    echo ""
    echo "Clave '$name' lista. Publica (dasela al server / ssh-copy-id):"
    echo "  $(cat "$key.pub")"
    echo ""
    echo "Falta commitear/pushear el vault:"
    echo "  git -C \"$VAULT_DIR\" commit -m \"feat(ssh): agrego clave $name\" && git -C \"$VAULT_DIR\" push"
}

# Pull del vault, aplica ssh/config, desencripta las .age que falten y restaura ~/.env si falta.
# --- [dotfiles] vault-sync: sincroniza (pull+push) el repo privado del vault | uso: vault-sync ---
vault-sync() {
    [[ -d "$VAULT_DIR/.git" ]] || { echo "No hay repo git en $VAULT_DIR (falta el vault?)" >&2; return 1; }

    # 1) Pull del remoto
    echo "Actualizando el vault ($VAULT_DIR)..."
    git -C "$VAULT_DIR" pull --rebase --autostash || { echo "Fallo el git pull del vault." >&2; return 1; }

    mkdir -p "$HOME/.ssh"; chmod 700 "$HOME/.ssh"

    # 2) Aplicar ssh/config (copia, no symlink — igual que el bootstrap)
    if [[ -f "$VAULT_DIR/ssh/config" ]]; then
        cp "$VAULT_DIR/ssh/config" "$HOME/.ssh/config" && chmod 600 "$HOME/.ssh/config"
        echo "ssh/config aplicado."
    fi

    # 3) Desencriptar las .age que falten
    command -v age &>/dev/null || { echo "Falta 'age' — no puedo desencriptar (bootstrap: --tools=age)" >&2; return 1; }
    local age_file name dst missing=0
    shopt -s nullglob
    for age_file in "$VAULT_DIR"/ssh/keys/*.age; do
        name="$(basename "$age_file" .age)"
        [[ -f "$HOME/.ssh/$name" ]] || missing=$((missing + 1))
    done

    if [[ "$missing" -eq 0 ]]; then
        echo "Todas las claves ya estan en ~/.ssh, nada que desencriptar."
    else
        # age lee la passphrase de /dev/tty, no de stdin: pregunta por cada clave.
        echo "age pedira la passphrase por cada clave nueva ($missing):"
        for age_file in "$VAULT_DIR"/ssh/keys/*.age; do
            name="$(basename "$age_file" .age)"; dst="$HOME/.ssh/$name"
            [[ -f "$dst" ]] && continue
            echo "  $name:"
            if age -d -o "$dst" "$age_file"; then
                chmod 600 "$dst"; echo "  desencriptada: $name"
            else
                rm -f "$dst"
                echo "  ERROR con $name (passphrase incorrecta?)" >&2
            fi
        done
    fi

    # 4) Copiar las publicas que falten
    for age_file in "$VAULT_DIR"/ssh/keys/*.pub; do
        dst="$HOME/.ssh/$(basename "$age_file")"
        [[ -f "$dst" ]] || { cp "$age_file" "$dst" && chmod 644 "$dst"; }
    done
    shopt -u nullglob
    # 5) Restaurar ~/.env desde el vault si falta (nunca pisa uno existente:
    #    el local puede tener tokens mas nuevos; para subirlo: env-save)
    if [[ -f "$VAULT_DIR/env/env.age" ]]; then
        if [[ -f "$HOME/.env" ]]; then
            echo "~/.env ya existe (no se pisa). Para subir cambios al vault: env-save"
        else
            echo "Restaurando ~/.env desde el vault:"
            if ( umask 077; age -d -o "$HOME/.env" "$VAULT_DIR/env/env.age" ); then
                chmod 600 "$HOME/.env"; echo "  ~/.env restaurado."
            else
                rm -f "$HOME/.env"
                echo "  ERROR restaurando ~/.env (passphrase incorrecta?)" >&2
            fi
        fi
    fi
    echo "vault-sync completo."
}

# Correrlo al agregar o rotar un token. Deja el 'git add' hecho; commit y push manuales.
# --- [dotfiles] env-save: cifra ~/.env con age y lo guarda en el vault | uso: env-save ---
env-save() {
    [[ -f "$HOME/.env" ]] || { echo "No existe ~/.env, nada que guardar." >&2; return 1; }
    command -v age &>/dev/null || { echo "Falta 'age' (bootstrap: --tools=age)" >&2; return 1; }
    [[ -d "$VAULT_DIR/.git" ]] || { echo "No hay repo git en $VAULT_DIR (falta el vault?)" >&2; return 1; }

    mkdir -p "$VAULT_DIR/env"
    local dst="$VAULT_DIR/env/env.age" tmp="$VAULT_DIR/env/env.age.tmp"
    # Cifrar a un temporal: si age falla (passphrase sin confirmar, Ctrl+C) el
    # env.age anterior del vault queda intacto.
    echo "Cifrando ~/.env con age (usa la MISMA passphrase que las claves del vault):"
    if ! age -p -o "$tmp" "$HOME/.env"; then
        rm -f "$tmp"
        echo "Fallo el cifrado con age; el vault quedo como estaba." >&2
        return 1
    fi
    mv -f "$tmp" "$dst"
    git -C "$VAULT_DIR" add env/env.age 2>/dev/null
    echo "~/.env guardado cifrado en el vault (env/env.age)."
    echo "Falta commitear/pushear el vault:"
    echo "  git -C \"$VAULT_DIR\" commit -m \"chore(env): actualizo env\" && git -C \"$VAULT_DIR\" push"
}

# ==============================================================================
# .ENV LOADER — cargar tokens desde ~/.env
# ==============================================================================

# --- [tools] _load_dotenv: (interna) carga variables desde un archivo .env | uso: _load_dotenv [archivo] ---
_load_dotenv() {
    local env_file="${1:-$HOME/.env}"
    [[ -f "$env_file" ]] || return 0

    while IFS= read -r line || [[ -n "$line" ]]; do
        # Ignorar lineas vacias y comentarios
        line="${line#"${line%%[![:space:]]*}"}"  # trim leading whitespace
        [[ -z "$line" || "$line" == \#* ]] && continue
        line="${line#export }"                   # tolerar 'export K=V'
        [[ "$line" == *=* ]] || continue         # sin '=' no es asignacion

        local key="${line%%=*}"
        local val="${line#*=}"
        # Tolerar espacios alrededor del '=' y comillas envolventes
        key="${key%"${key##*[![:space:]]}"}"     # trim trailing ws de la clave
        val="${val#"${val%%[![:space:]]*}"}"     # trim leading ws del valor
        val="${val%\"}"
        val="${val#\"}"
        val="${val%\'}"
        val="${val#\'}"
        # Clave invalida (espacios, etc.): saltear en vez de romper el export
        [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue

        export "$key=$val"
    done < "$env_file"
}

_load_dotenv

