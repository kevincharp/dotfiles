# --- [nav] open: abrir directorio o archivo con la app por defecto (por defecto: .) | uso: open [ruta] ---
open() {
    local target="${1:-.}"
    if [[ "$IS_WINDOWS" == true ]]; then
        cmd.exe //c start "" "$(cygpath -w "$target")" 2>/dev/null \
            || start "" "$target" 2>/dev/null
    else
        xdg-open "$target" 2>/dev/null &
    fi
}

# --- [nav] edit: abrir archivo en el editor (VSCode si está, si no nvim) | uso: edit <archivo> ---
edit() {
    local target="${1:?Uso: edit <archivo>}"
    if command -v code &>/dev/null; then
        code "$target"
    else
        "${VISUAL:-${EDITOR:-nvim}}" "$target"
    fi
}

# --- [nav] y: yazi con cd-on-exit (queda en el último dir navegado) | uso: y [ruta] ---
# Al salir deja el shell en el ultimo directorio navegado (--cwd-file).
if command -v yazi &>/dev/null; then
    y() {
        local tmp cwd
        tmp="$(mktemp -t yazi-cwd.XXXXXX)"
        yazi "$@" --cwd-file="$tmp"
        if cwd="$(command cat -- "$tmp")" && [[ -n "$cwd" && "$cwd" != "$PWD" ]]; then
            builtin cd -- "$cwd" || return
        fi
        rm -f -- "$tmp"
    }
fi

