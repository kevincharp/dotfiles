# ==============================================================================
# OS DETECTION
# ==============================================================================

# $OSTYPE no lanza un proceso: en Windows cada spawn cuesta ~0.5s por el antivirus.
case "$OSTYPE" in
    msys*|cygwin*|win32*)
        IS_WINDOWS=true
        ;;
    *)
        IS_WINDOWS=false
        ;;
esac

# Cache de los `init` de zoxide y fzf: evita un proceso por arranque. Se regenera
# si el binario es mas nuevo. Uso: _init_cacheado <nombre> <cmd...>
if [[ "$IS_WINDOWS" == true ]]; then
    _INIT_CACHE_DIR="$HOME/AppData/Local/bash-init-cache"
else
    _INIT_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/bash-init"
fi
_init_cacheado() {
    local nombre="$1"; shift
    local bin cache="$_INIT_CACHE_DIR/$nombre.bash"
    bin="$(command -v "$1")" || return 1
    if [[ ! -s "$cache" || "$bin" -nt "$cache" ]]; then
        mkdir -p "$_INIT_CACHE_DIR" 2>/dev/null
        "$@" > "$cache.tmp" 2>/dev/null && [[ -s "$cache.tmp" ]] \
            && mv -f "$cache.tmp" "$cache" || { rm -f "$cache.tmp"; return 1; }
    fi
    source "$cache"
    return 0
}

# ==============================================================================
# PATH — Agregar ~/.local/bin (para oh-my-posh, zoxide, etc.)
# ==============================================================================

if [[ -d "$HOME/.local/bin" ]]; then
    export PATH="$HOME/.local/bin:$PATH"
fi

# opencode (instalador SST) deja el binario en ~/.opencode/bin
if [[ -d "$HOME/.opencode/bin" ]]; then
    export PATH="$HOME/.opencode/bin:$PATH"
fi

# pip --user en Git Bash deja los .exe en Roaming/Python/PythonXYZ/Scripts, fuera del PATH.
for _py_scripts in "$HOME"/AppData/Roaming/Python/Python*/Scripts; do
    [[ -d "$_py_scripts" ]] && export PATH="$_py_scripts:$PATH"
done
unset _py_scripts

# Rust/cargo: la carga vive aca y no en ~/.profile.
[[ -f "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"

# ==============================================================================
# BLE.SH — syntax highlighting + autosugerencias (equivalente de PSReadLine)
# ------------------------------------------------------------------------------
# Con el attach por defecto: '--noattach' + 'ble-attach' empeora el redibujado del prompt.
# ==============================================================================

_BLESH_DIR="$HOME/.local/share/blesh"
if [[ $- == *i* && -f "$_BLESH_DIR/ble.sh" ]]; then
    source "$_BLESH_DIR/ble.sh"
fi

# ==============================================================================
# PROMPT — oh-my-posh con tema spaceship
# ==============================================================================

if command -v oh-my-posh &>/dev/null; then
    if [[ "$IS_WINDOWS" == true ]]; then
        _omp_theme="${POSH_THEMES_PATH:-$HOME/AppData/Local/Programs/oh-my-posh/themes}/claude-code.omp.json"
        _omp_fallback="${POSH_THEMES_PATH:-$HOME/AppData/Local/Programs/oh-my-posh/themes}/spaceship.omp.json"
    else
        _omp_theme="${XDG_CONFIG_HOME:-$HOME/.config}/oh-my-posh/themes/claude-code.omp.json"
        _omp_fallback=""
    fi
    # En Windows oh-my-posh es MSIX y no puede autoactualizarse: se usa una copia local
    # del tema con upgrade apagado, regenerada si el original cambia.
    if [[ "$IS_WINDOWS" == true && -f "$_omp_theme" ]]; then
        _omp_local="$HOME/AppData/Local/bash-init-cache/claude-code.omp.json"
        if [[ ! -f "$_omp_local" || "$_omp_theme" -nt "$_omp_local" ]]; then
            mkdir -p "${_omp_local%/*}" 2>/dev/null
            sed -E 's/("(auto|notice)"[[:space:]]*:[[:space:]]*)true/\1false/' \
                "$_omp_theme" > "$_omp_local" 2>/dev/null || : > "$_omp_local"
        fi
        [[ -s "$_omp_local" ]] && _omp_theme="$_omp_local"
        unset _omp_local
    fi
    if [[ -f "$_omp_theme" ]]; then
        eval "$(oh-my-posh init bash --config "$_omp_theme")"
    elif [[ -n "$_omp_fallback" && -f "$_omp_fallback" ]]; then
        eval "$(oh-my-posh init bash --config "$_omp_fallback")"
    else
        eval "$(oh-my-posh init bash --config spaceship)"
    fi
    unset _omp_theme _omp_fallback
else
    echo "oh-my-posh no instalado"
    echo "  Windows: winget install JanDeDobbeleer.OhMyPosh"
    echo "  Linux:   curl -s https://ohmyposh.dev/install.sh | bash -s"
fi

