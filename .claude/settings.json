{
  "cleanupPeriodDays": 30,
  "env": {
    "CLAUDE_CODE_ENABLE_AUTO_MODE": "1"
  },
  "model": "claude-sonnet-5",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.dotfiles/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "mattpocock-skills@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "claude-security@claude-plugins-official": true,
    "watch@claude-video": true,
    "bibliotecario@kevincharp-dotfiles": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/skills.git"
      }
    },
    "kevincharp-dotfiles": {
      "source": {
        "source": "github",
        "repo": "kevincharp/dotfiles"
      },
      "autoUpdate": true
    },
    "ui-ux-pro-max-skill": {
      "source": {
        "source": "github",
        "repo": "nextlevelbuilder/ui-ux-pro-max-skill"
      },
      "autoUpdate": true
    },
    "diagram-design": {
      "source": {
        "source": "git",
        "url": "https://github.com/cathrynlavery/diagram-design.git"
      }
    },
    "taste-skill": {
      "source": {
        "source": "git",
        "url": "https://github.com/Leonxlnx/taste-skill.git"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      },
      "autoUpdate": true
    },
    "claude-video": {
      "source": {
        "source": "github",
        "repo": "bradautomates/claude-video"
      },
      "autoUpdate": false
    }
  },
  "modelSettings": {
    "claude-sonnet-5": {}
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "auto"
}
