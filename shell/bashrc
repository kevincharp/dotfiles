# ==============================================================================
# FLECHA ARRIBA → lista de historial estilo PSReadLine ListView (espejo del zshrc)
# ------------------------------------------------------------------------------
# ↑ abre fzf con el historial filtrado por prefijo; Ctrl+R sigue siendo la busqueda difusa.
# Con ble.sh las teclas se ligan con 'ble-bind'; sin el, con 'bind -x'.
# ==============================================================================
if [[ $- == *i* ]] && command -v fzf &>/dev/null; then
    # Historial reciente primero, deduplicado y filtrado por prefijo. El sed quita el
    # numero de evento y el timestamp de HISTTIMEFORMAT.
    _fzf_history_widget() {
        local query="$READLINE_LINE" selection
        selection=$(history | tac \
            | sed -E 's/^[[:space:]]*[0-9]+[[:space:]]+([0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}[[:space:]]+)?//' \
            | awk '!seen[$0]++' \
            | fzf ${query:+--query="^$query"} --no-sort --scheme=history \
                  --tiebreak=index --prompt=' historial> ')
        if [[ -n "$selection" ]]; then
            READLINE_LINE="$selection"
            READLINE_POINT=${#READLINE_LINE}
        fi
    }
    if [[ -n "${BLE_VERSION-}" ]]; then
        # ble.sh aplica el bind al adjuntarse en el primer prompt.
        ble-bind -x 'up' '_fzf_history_widget' 2>/dev/null
    else
        # Sin ble.sh: readline.
        bind -x '"\e[A": _fzf_history_widget' 2>/dev/null
        bind -x '"\eOA": _fzf_history_widget' 2>/dev/null
    fi
fi

