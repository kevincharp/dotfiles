<!--
    Name: Claude Code
    IsDark: True
    HasBlur: True

    Tema propio de los dotfiles, hecho a partir de "Blur Black Darker" con la
    paleta del esquema "Claude Code" de Windows Terminal (terminal/settings.json):
      fondo #2B2322 · texto #E8E0D4 · acento #D4874E · seleccion #4A3A35
    Sin icono de lupa en la caja de busqueda (SearchIconStyle colapsado).
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Themes/Base.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <system:Boolean x:Key="ThemeBlurEnabled">True</system:Boolean>
    <system:String x:Key="SystemBG">Dark</system:String>
    <Color x:Key="LightBG">#C72B2322</Color>
    <Color x:Key="DarkBG">#C72B2322</Color>
    <Thickness x:Key="ResultMargin">0 0 0 8</Thickness>

    <Style x:Key="WindowRadius" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style
        x:Key="ItemGlyph"
        BasedOn="{StaticResource BaseGlyphStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#E8E0D4" />
    </Style>
    <Style
        x:Key="QueryBoxStyle"
        BasedOn="{StaticResource BaseQueryBoxStyle}"
        TargetType="{x:Type TextBox}">
        <Setter Property="Foreground" Value="#E8E0D4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CaretBrush" Value="#D4874E" />
        <Setter Property="SelectionBrush" Value="#D4874E" />
    </Style>

    <Style
        x:Key="QuerySuggestionBoxStyle"
        BasedOn="{StaticResource BaseQuerySuggestionBoxStyle}"
        TargetType="{x:Type TextBox}">
        <Setter Property="Foreground" Value="#E8E0D4" />
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <Style
        x:Key="WindowBorderStyle"
        BasedOn="{StaticResource BaseWindowBorderStyle}"
        TargetType="{x:Type Border}">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#D4874E" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Opacity="0.9" Color="#2B2322" />
            </Setter.Value>
        </Setter>
    </Style>
    <Style
        x:Key="SeparatorStyle"
        BasedOn="{StaticResource BaseSeparatorStyle}"
        TargetType="{x:Type Rectangle}">
        <Setter Property="Fill" Value="#5C4A44" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="12 0 12 8" />
    </Style>

    <Style
        x:Key="WindowStyle"
        BasedOn="{StaticResource BaseWindowStyle}"
        TargetType="{x:Type Window}">
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Opacity="0.7" Color="#2B2322" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="PendingLineStyle"
        BasedOn="{StaticResource BasePendingLineStyle}"
        TargetType="{x:Type Line}">
        <Setter Property="Stroke" Value="#D4874E" />
    </Style>

    <!--  Item Style  -->
    <Style
        x:Key="ItemTitleStyle"
        BasedOn="{StaticResource BaseItemTitleStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#E8E0D4" />
    </Style>
    <Style
        x:Key="ItemSubTitleStyle"
        BasedOn="{StaticResource BaseItemSubTitleStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#E8E0D4" />
        <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style
        x:Key="ItemTitleSelectedStyle"
        BasedOn="{StaticResource BaseItemTitleSelectedStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#F5EFE7" />
    </Style>
    <Style
        x:Key="ItemSubTitleSelectedStyle"
        BasedOn="{StaticResource BaseItemSubTitleSelectedStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#E8E0D4" />
        <Setter Property="Opacity" Value="0.6" />
    </Style>
    <!--  Seleccion estilo Claude Code: barra naranja a la izquierda (~3px) + fondo calido.
          Gradiente con corte duro: no se pueden tocar los templates de Base.xaml.  -->
    <LinearGradientBrush x:Key="ItemSelectedBackgroundColor" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#D4874E" />
        <GradientStop Offset="0.006" Color="#D4874E" />
        <GradientStop Offset="0.006" Color="#4A3A35" />
        <GradientStop Offset="1" Color="#4A3A35" />
    </LinearGradientBrush>

    <!--  button style in the middle of the scrollbar  -->
    <Style
        x:Key="ThumbStyle"
        BasedOn="{StaticResource BaseThumbStyle}"
        TargetType="{x:Type Thumb}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border
                        Background="#D4874E"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        CornerRadius="2"
                        DockPanel.Dock="Right"
                        Opacity="0.5" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="ScrollBarStyle"
        BasedOn="{StaticResource BaseScrollBarStyle}"
        TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="#5C4A44" />
    </Style>
    <!--  Sin lupa. Visibility/Opacity del icono los pisa un binding del ViewModel
          (SearchIconVisibility/Opacity), asi que un Setter ahi no alcanza: se
          anulan las propiedades que el binding no toca (tamano y relleno).  -->
    <Style
        x:Key="SearchIconStyle"
        BasedOn="{StaticResource BaseSearchIconStyle}"
        TargetType="{x:Type Path}">
        <Setter Property="Width" Value="0" />
        <Setter Property="Height" Value="0" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Stroke" Value="Transparent" />
    </Style>
    <Style
        x:Key="ItemHotkeyStyle"
        BasedOn="{StaticResource BaseItemHotkeyStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#E8E0D4" />
        <Setter Property="Opacity" Value="0.3" />
    </Style>
    <Style
        x:Key="ItemHotkeySelectedStyle"
        BasedOn="{StaticResource BaseItemHotkeySelectedStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#E8E0D4" />
        <Setter Property="Opacity" Value="0.3" />
    </Style>
    <Style
        x:Key="ClockBox"
        BasedOn="{StaticResource BaseClockBox}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#E8E0D4" />
        <Setter Property="Opacity" Value="0.3" />
    </Style>
    <Style
        x:Key="DateBox"
        BasedOn="{StaticResource BaseDateBox}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#E8E0D4" />
        <Setter Property="Opacity" Value="0.3" />
    </Style>
    <Style
        x:Key="PreviewBorderStyle"
        BasedOn="{StaticResource BasePreviewBorderStyle}"
        TargetType="{x:Type Border}">
        <Setter Property="BorderBrush" Value="#5C4A44" />
    </Style>
    <Style
        x:Key="PreviewItemTitleStyle"
        BasedOn="{StaticResource BasePreviewItemTitleStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#E8E0D4" />
    </Style>
    <Style
        x:Key="PreviewItemSubTitleStyle"
        BasedOn="{StaticResource BasePreviewItemSubTitleStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#E8E0D4" />
        <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style
        x:Key="PreviewGlyph"
        BasedOn="{StaticResource BasePreviewGlyph}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#E8E0D4" />
    </Style>
</ResourceDictionary>
