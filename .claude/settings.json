{
  "env": {
    "CLAUDE_CODE_ENABLE_AUTO_MODE": "1"
  },
  "model": "claude-sonnet-5",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.dotfiles/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "example-skills@anthropic-agent-skills": true,
    "the-architect@soyenriquerocha": true,
    "cyber-neo@kevincharp-dotfiles": true,
    "all-deploy@kevincharp-dotfiles": true,
    "ui-ux-pro-max@ui-ux-pro-max-skill": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "premium-website-generator@kevincharp-dotfiles": true,
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "landing-cro@kevincharp-dotfiles": true,
    "landing-a-secciones@kevincharp-dotfiles": true,
    "diagram-design@diagram-design": true,
    "taste-skill@taste-skill": true,
    "impeccable@impeccable": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/skills.git"
      }
    },
    "soyenriquerocha": {
      "source": {
        "source": "github",
        "repo": "Hainrixz/the-architect"
      },
      "autoUpdate": true
    },
    "kevincharp-dotfiles": {
      "source": {
        "source": "github",
        "repo": "kevincharp/dotfiles"
      },
      "autoUpdate": true
    },
    "ui-ux-pro-max-skill": {
      "source": {
        "source": "github",
        "repo": "nextlevelbuilder/ui-ux-pro-max-skill"
      },
      "autoUpdate": true
    },
    "diagram-design": {
      "source": {
        "source": "git",
        "url": "https://github.com/cathrynlavery/diagram-design.git"
      }
    },
    "taste-skill": {
      "source": {
        "source": "git",
        "url": "https://github.com/Leonxlnx/taste-skill.git"
      }
    },
    "impeccable": {
      "source": {
        "source": "git",
        "url": "https://github.com/pbakaus/impeccable.git"
      }
    }
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "auto"
}
